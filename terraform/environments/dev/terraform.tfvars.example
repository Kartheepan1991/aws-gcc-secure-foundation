# Example Terraform variables - Copy to terraform.tfvars and customize
# DO NOT commit terraform.tfvars to git (it's gitignored)

# AWS Configuration
aws_region  = "ap-southeast-1"
environment = "dev"
project_name = "gcc-secure-foundation"
app_name     = "gcc-app"

# VPC Configuration (2 AZs as required)
vpc_cidr             = "10.0.0.0/16"
public_subnet_cidrs  = ["10.0.1.0/24", "10.0.2.0/24"]
private_subnet_cidrs = ["10.0.11.0/24", "10.0.12.0/24"]

# EKS Configuration
eks_cluster_version = "1.28"
desired_nodes       = 2
min_nodes           = 1
max_nodes           = 3
instance_types      = ["t3.medium"]  # Free tier: t2.micro (limited), t3.medium for performance

# GitHub Configuration (for CI/CD IAM trust)
github_repo = "Kartheepan1991/aws-gcc-secure-foundation"

# ALB Configuration (Optional - if you create ACM certificate)
# acm_certificate_arn = "arn:aws:acm:ap-southeast-1:ACCOUNT:certificate/CERT_ID"
# alb_logs_bucket     = "gcc-alb-logs-ap-southeast-1"

# Additional Tags
additional_tags = {
  Owner       = "DevOps Team"
  CostCenter  = "Engineering"
  Compliance  = "GCC"
  Purpose     = "Interview Assessment"
}
